{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "logToFile": true,
            "args": [
                "--fname=configs/pretrain/vitl16.yaml",
                // "--devices", "cuda:0", "cuda:1", "cuda:2", "cuda:3"
                "--devices", "cuda:0"
            ],
            "env": {
                "OMP_NUM_THREADS": "4", 
                // "CUDA_VISIBLE_DEVICES": "0,1,2,3"
                "CUDA_VISIBLE_DEVICES": "0"
            }
        }
    ]
}