{
    "version": "0.2.0",
    "configurations": [
        
    
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "logToFile": true,
            "args": [
                "--fname=configs/pretrain_mae/vitb16_mri_mae2.1_p.yaml",
                "--devices",
                "cuda:0"
                // "--devices", "cuda:0", "cuda:1", "cuda:2", "cuda:3"
            ],
            "env": {
                //"OMP_NUM_THREADS": "4", 
                // "CUDA_VISIBLE_DEVICES": "0,1,2,3"
                "CUDA_VISIBLE_DEVICES": "0"
            }
        }
    ]
}